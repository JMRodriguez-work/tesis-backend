{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tfg-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
  },
  "env": {
    "production": {
      "name": "tfg-backend",
      "vars": {
        "BETTER_AUTH_URL": "https://tfg-backend.<your-subdomain>.workers.dev",
      },
    },
  },
}
