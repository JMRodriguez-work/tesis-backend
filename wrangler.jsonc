{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tfg-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-09",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787"
  },
  "observability": {
    "enabled": true
  }
}
