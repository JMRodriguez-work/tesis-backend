{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tfg-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
  },
  "queues": {
    "producers": [
      { "queue": "tfg-analytics", "binding": "ANALYTICS_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "tfg-analytics",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 5,
        "dead_letter_queue": "tfg-analytics-dlq",
        "max_concurrency": 3
      }
    ]
  },
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  "env": {
    "production": {
      "name": "tfg-backend",
      "vars": {
        "BETTER_AUTH_URL": "https://tfg-backend.<your-subdomain>.workers.dev",
      },
      "queues": {
        "producers": [
          { "queue": "tfg-analytics-prod", "binding": "ANALYTICS_QUEUE" }
        ],
        "consumers": [
          {
            "queue": "tfg-analytics-prod",
            "max_batch_size": 25,
            "max_batch_timeout": 15,
            "max_retries": 5,
            "dead_letter_queue": "tfg-analytics-prod-dlq",
            "max_concurrency": 10
          }
        ]
      },
      "triggers": {
        "crons": ["0 6 * * *"]
      }
    }
  }
}
